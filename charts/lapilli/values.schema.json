{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Lapilli chart values",
  "description": "Unknown keys in Lapilli's own sections are rejected so a typo can't be silently ignored. `global` is allowed for umbrella charts. See docs/COMPATIBILITY.md §5.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "reconcileConcurrency": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024,
      "description": "How many captures may be collected at once. 0 is unbounded, which is kube-rs's default and was measured to reach 80% of a 256Mi limit on a 20-alert storm."
    },
    "clusterId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,83}$"
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "maxLength": 253,
          "description": "A CaptureProfile object name, so an RFC 1123 subdomain. The CRD carries the same pattern on spec.profile: a value this accepts and the CRD refuses would install and then never produce a capture."
        },
        "preSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "postSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "collectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "logs",
              "resources",
              "events",
              "changes",
              "metrics"
            ]
          }
        },
        "deferred": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "logs",
              "resources",
              "events",
              "changes",
              "metrics"
            ]
          },
          "description": "Collectors this profile declares it does not run because the data is kept elsewhere; recorded in every bundle as coverage.deferred. Must not overlap collectors (the CRD's CEL rule refuses the overlap at apply time; JSON Schema cannot express it here)."
        },
        "notifyRoute": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
          "description": "The name of a notify.routes entry whose channel this profile's captures are announced in. Empty (default): not announced."
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusUrl": {
          "description": "Empty (off) or an http(s) base URL with a plain host[:port] and an optional path prefix. No credentials, query, fragment or bracketed IP literal (write a name or an IPv4 literal): the controller refuses those, and plain http:// only for cluster-local or loopback hosts.",
          "type": "string",
          "pattern": "^(|https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~-]+)*/?)$"
        },
        "stepSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "query": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "diffs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMaps": {
          "type": "boolean"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "default",
            "strict",
            "off"
          ]
        },
        "plaintext": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "static",
            "kms"
          ]
        },
        "keySecret": {
          "type": "string"
        },
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "pattern": "^arn:(aws|aws-cn|aws-us-gov):kms:[a-z0-9-]+:[0-9]{12}:key/[A-Za-z0-9_-]+$"
                },
                {
                  "pattern": "^projects/[A-Za-z0-9_-]+/locations/[A-Za-z0-9_-]+/keyRings/[A-Za-z0-9_-]+/cryptoKeys/[A-Za-z0-9_-]+/cryptoKeyVersions/[0-9]+$"
                }
              ]
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "logLevel": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "url": {
                "type": "string",
                "pattern": "^(s3|gs)://[^/]+(/.*)?$"
              },
              "region": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "allowHttp": {
                "type": "boolean"
              },
              "credentialsSecret": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "maxCapturesPerPayload": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Most captures one webhook payload may create; 0 = unlimited. Alerts past it are counted in lapilli_alerts_dropped_total{reason=\"payload-cap\"}."
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrapeAnnotations": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "description": "Notification destinations. A CaptureProfile may only name one of these; it cannot define a route, point it elsewhere, or raise its detail level.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "host",
              "pathSecret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
                "description": "What a CaptureProfile's spec.notify.route references."
              },
              "host": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(:[0-9]{1,5})?$",
                "description": "host[:port], never a URL: no scheme, no path, no credentials. Lives here rather than in the Secret so a change rolls the pod and cannot silently repoint the endpoint."
              },
              "pathSecret": {
                "type": "string",
                "minLength": 1,
                "description": "Secret in the release namespace with a `path` key, e.g. /services/T000/B000/xxxx. Only that key is mounted."
              },
              "format": {
                "enum": [
                  "slack",
                  "json"
                ]
              },
              "detail": {
                "enum": [
                  "facts",
                  "content"
                ],
                "description": "facts: no value taken from the workload. content: also the changed field and its redacted before/after values. A log line is never sent in either mode."
              },
              "maxPerWindow": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "includeDemo": {
                "type": "boolean",
                "description": "Also announce captures labelled lapilli.dev/export: local, which is what `lapilli demo` creates."
              },
              "insecureHttp": {
                "type": "boolean",
                "description": "Talk to this route over plain HTTP. Tests only: it also needs LAPILLI_NOTIFY_ALLOW_HTTP in extraEnv, and even then only a cluster-local or loopback host is accepted."
              }
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 25,
      "description": "Seconds the kubelet waits after SIGTERM before SIGKILL. Lapilli needs at least 25: the captures in flight get 12s and the notification flush 10s, and a truncated flush marks captures notified that were never announced."
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bundle lifecycle. Nothing deletes a sealed bundle unless this is enabled; see docs/design-retention.md.",
      "properties": {
        "maxBytes": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Ceiling for the bundle volume in bytes. Empty = derived from persistence.size x 0.8; \"0\" disables the byte bound."
        },
        "days": {
          "type": "integer",
          "minimum": 0,
          "description": "Also reclaim bundles older than this many days. 0 = off. A secondary trim: on the default 1Gi volume an age window never engages before the disk fills."
        },
        "minFreeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Refuse to start a capture with less than this free, so it fails with a pvc-full reason code instead of a raw ENOSPC part-way through collection. 0 = off."
        },
        "allowUnexported": {
          "type": "boolean",
          "description": "Reclaim bundles that reached no destination. On a PVC-only install that is the only copy of the evidence, so this is off by default and must be chosen deliberately."
        },
        "reclaimOrphans": {
          "type": "boolean",
          "description": "Reclaim files whose IncidentCapture no longer exists. Off by default: nothing in Lapilli deletes a capture, so this would let one `kubectl delete incidentcapture --all` authorise a mass delete."
        }
      }
    }
  }
}

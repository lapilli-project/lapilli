{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "incidentcaptures.lapilli.dev"
  },
  "spec": {
    "group": "lapilli.dev",
    "names": {
      "categories": [],
      "kind": "IncidentCapture",
      "plural": "incidentcaptures",
      "shortNames": [],
      "singular": "incidentcapture"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".status.phase",
            "name": "Phase",
            "type": "string"
          },
          {
            "jsonPath": ".status.bundlePath",
            "name": "Bundle",
            "type": "string"
          },
          {
            "jsonPath": ".status.exportSummary",
            "name": "Export",
            "type": "string"
          },
          {
            "jsonPath": ".status.notification.state",
            "name": "Notify",
            "type": "string"
          },
          {
            "jsonPath": ".metadata.creationTimestamp",
            "name": "Age",
            "type": "date"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "One Kubernetes incident capture: trigger metadata + capture window, driven through a phase machine.",
            "properties": {
              "spec": {
                "description": "One incident capture, created by a trigger. The controller reconciles its status.",
                "properties": {
                  "clusterId": {
                    "description": "Stable cluster identifier, recorded in the bundle.",
                    "type": "string"
                  },
                  "incidentId": {
                    "description": "Unique, non-reusable incident id. Bound into the signed manifest (replay defense).",
                    "type": "string"
                  },
                  "profile": {
                    "description": "Name of the `CaptureProfile` (same namespace) governing this capture.",
                    "type": "string"
                  },
                  "skipRemoteExport": {
                    "description": "Keep this capture local: skip the profile's object-store destinations (set for alerts labeled `lapilli.dev/export: local`, e.g. `lapilli demo`).",
                    "type": "boolean"
                  },
                  "target": {
                    "description": "Namespace/name of the primary workload involved (owner-chain root for collectors).",
                    "properties": {
                      "container": {
                        "description": "Optional specific container; defaults to all containers in the pod.",
                        "nullable": true,
                        "type": "string"
                      },
                      "namespace": {
                        "type": "string"
                      },
                      "pod": {
                        "description": "Pod name to collect logs from (v0.1 collects previous-container tails from this pod).",
                        "type": "string"
                      }
                    },
                    "required": [
                      "namespace",
                      "pod"
                    ],
                    "type": "object"
                  },
                  "trigger": {
                    "description": "The trigger that fired.",
                    "properties": {
                      "firingTs": {
                        "description": "RFC 3339 firing timestamp (self-asserted upstream; see DESIGN §5).",
                        "type": "string"
                      },
                      "rule": {
                        "description": "The alert rule / alertname that fired. Whoever wrote the `PrometheusRule` chose this string, and it is rendered into a chat message, so the API refuses the three characters a renderer could mistake for markup. Renderers escape it as well: this is the boundary check, not the only one.",
                        "pattern": "^[^<>&]{1,200}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "firingTs",
                      "rule"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "clusterId",
                  "incidentId",
                  "profile",
                  "target",
                  "trigger"
                ],
                "type": "object"
              },
              "status": {
                "nullable": true,
                "properties": {
                  "bundlePath": {
                    "description": "Path of the sealed bundle once exported.",
                    "nullable": true,
                    "type": "string"
                  },
                  "exportSummary": {
                    "description": "One-line summary for `kubectl get`, e.g. `evidence=uploaded`.",
                    "nullable": true,
                    "type": "string"
                  },
                  "exports": {
                    "additionalProperties": {
                      "properties": {
                        "attempts": {
                          "default": 0,
                          "format": "uint32",
                          "minimum": 0.0,
                          "type": "integer"
                        },
                        "lastAttemptAt": {
                          "nullable": true,
                          "type": "string"
                        },
                        "reason": {
                          "description": "Fixed reason code; details are in the controller log only.",
                          "nullable": true,
                          "type": "string"
                        },
                        "sha256": {
                          "description": "SHA-256 of the uploaded object (`lapilli verify s3://… --expect-sha256`).",
                          "nullable": true,
                          "type": "string"
                        },
                        "state": {
                          "enum": [
                            "pending",
                            "uploaded",
                            "refused",
                            "conflict",
                            "failed"
                          ],
                          "type": "string"
                        },
                        "uploadedAt": {
                          "nullable": true,
                          "type": "string"
                        },
                        "url": {
                          "description": "Full object URL (e.g. `s3://bucket/prefix/cluster/incident.ieb`).",
                          "nullable": true,
                          "type": "string"
                        },
                        "versionId": {
                          "description": "The store's version id of the uploaded object, on a versioned bucket (`lapilli verify s3://… --version-id`).",
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "state"
                      ],
                      "type": "object"
                    },
                    "description": "Remote copies, keyed by destination name (a map, so each entry is patched alone).",
                    "type": "object"
                  },
                  "local": {
                    "description": "What happened to the **local** copy. **Reporting only**, like `notification`: the durable record of a reclaim is the journal at the bundle root, because this field dies with the CR and a Kubernetes Event expires within the hour (docs/design-retention.md).",
                    "nullable": true,
                    "properties": {
                      "at": {
                        "description": "RFC 3339 instant the local copy was reclaimed.",
                        "type": "string"
                      },
                      "reason": {
                        "description": "A fixed code, never transport text: `max-bytes`, `age`, `orphan`.",
                        "type": "string"
                      },
                      "state": {
                        "description": "`reclaimed` is the only value today. Absent means the bundle is still where `bundlePath` says it is.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "at",
                      "reason",
                      "state"
                    ],
                    "type": "object"
                  },
                  "message": {
                    "description": "Human-readable detail (error message on Failed, progress otherwise).",
                    "nullable": true,
                    "type": "string"
                  },
                  "notification": {
                    "description": "What happened to this incident's summary message. **Reporting only**: the dispatcher's once-only guard is the `<incident>.notified` file, so patching this changes nothing.",
                    "nullable": true,
                    "properties": {
                      "at": {
                        "description": "When the dispatcher settled it (RFC 3339).",
                        "type": "string"
                      },
                      "reason": {
                        "description": "A fixed code on anything but `sent`, never transport text and never a webhook response body (a 4xx body can quote the request that was sent): one of `unreachable`, `timeout`, `endpoint-refused`, `endpoint-error`, `rate-limited-by-endpoint`, `endpoint-redirected`, `route-unusable`, `rate-capped`, `claim-failed`, `already-notified`, `in-cooldown`.",
                        "nullable": true,
                        "type": "string"
                      },
                      "route": {
                        "description": "The route it went to, so a team can tell which channel has it.",
                        "nullable": true,
                        "type": "string"
                      },
                      "state": {
                        "description": "`sent`, `repeat`, `failed`, `suppressed`, `dropped` or `already-notified`.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "at",
                      "state"
                    ],
                    "type": "object"
                  },
                  "observedGeneration": {
                    "description": "The `.metadata.generation` this status was computed for (idempotency).",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "phase": {
                    "default": "Pending",
                    "description": "Current phase of the capture.",
                    "enum": [
                      "Pending",
                      "Capturing",
                      "Sealing",
                      "Exported",
                      "Failed"
                    ],
                    "type": "string"
                  },
                  "seal": {
                    "description": "KMS signing (docs/design-kms.md): attempts while `Sealing`, and once signed, what matches the cloud's audit log. Informational: never trusted as input.",
                    "nullable": true,
                    "properties": {
                      "attempts": {
                        "default": 0,
                        "description": "Signing attempts so far in this round.",
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "key": {
                        "description": "The KMS key (ARN or version) and the `ieb/v1` key id it signed with.",
                        "nullable": true,
                        "type": "string"
                      },
                      "keyId": {
                        "nullable": true,
                        "type": "string"
                      },
                      "manifestSha256": {
                        "description": "SHA-256 of the signed manifest and the cloud request id, to match audit log entries.",
                        "nullable": true,
                        "type": "string"
                      },
                      "nextAttemptAt": {
                        "nullable": true,
                        "type": "string"
                      },
                      "reason": {
                        "description": "Fixed reason code of the last failure (`signing-unavailable`, `signing-denied`, …).",
                        "nullable": true,
                        "type": "string"
                      },
                      "requestId": {
                        "nullable": true,
                        "type": "string"
                      },
                      "retryToken": {
                        "description": "The `lapilli.dev/retry-seal` annotation value last acted on.",
                        "nullable": true,
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "IncidentCapture",
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
---
{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "captureprofiles.lapilli.dev"
  },
  "spec": {
    "group": "lapilli.dev",
    "names": {
      "categories": [],
      "kind": "CaptureProfile",
      "plural": "captureprofiles",
      "shortNames": [],
      "singular": "captureprofile"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "Reusable Lapilli capture policy: window, collectors, export target, signing mode.",
            "properties": {
              "spec": {
                "description": "Reusable capture policy. Referenced by `IncidentCapture.spec.profile`.",
                "properties": {
                  "collectors": {
                    "default": [
                      "logs"
                    ],
                    "description": "Collectors to run: \"logs\", \"resources\", \"events\", \"changes\", \"metrics\".",
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "x-kubernetes-list-type": "set"
                  },
                  "diffs": {
                    "default": {
                      "configMaps": false
                    },
                    "description": "What `diffs/` may read beyond the owner chain.",
                    "properties": {
                      "configMaps": {
                        "default": false,
                        "description": "When a rollout changed which ConfigMap the pod template references (kustomize hash suffixes, immutable ConfigMaps), GET both and diff them key by key. Needs `get configmaps` in the watched namespaces (the chart only allows it with watchNamespaces).",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "export": {
                    "default": {
                      "path": "/var/lib/lapilli/bundles"
                    },
                    "description": "Where to write the sealed bundle.",
                    "properties": {
                      "destinations": {
                        "description": "Names of object-store destinations to copy each bundle to. Destinations themselves (URL, endpoint, credentials) are defined by the admin in the controller's configuration and can't be changed here; unknown names are refused.",
                        "items": {
                          "type": "string"
                        },
                        "type": "array",
                        "x-kubernetes-list-type": "set"
                      },
                      "path": {
                        "default": "/var/lib/lapilli/bundles",
                        "description": "Path Lapilli writes bundles to (a mounted PVC in-cluster). Default `/var/lib/lapilli/bundles`.",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "metrics": {
                    "description": "Prometheus range queries around the window, used by the \"metrics\" collector.",
                    "nullable": true,
                    "properties": {
                      "prometheusUrl": {
                        "description": "Base URL of a Prometheus-compatible HTTP API, e.g. `http://prometheus.monitoring:9090`.",
                        "type": "string"
                      },
                      "queries": {
                        "default": [],
                        "description": "Range queries to snapshot. `$namespace`, `$pod` and `$container` are replaced with the capture target's values (escaped for a PromQL string). Empty = Lapilli's built-in set.",
                        "items": {
                          "properties": {
                            "name": {
                              "description": "File-safe name: the result lands in `metrics/<name>.json`. `[a-z0-9_-]`, max 64 chars.",
                              "type": "string"
                            },
                            "query": {
                              "description": "PromQL expression.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "query"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "stepSeconds": {
                        "default": 15,
                        "description": "Minimum resolution in seconds (default 15). Widened automatically so no series exceeds 1000 points.",
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "prometheusUrl"
                    ],
                    "type": "object"
                  },
                  "notify": {
                    "default": {
                      "route": ""
                    },
                    "description": "Where a one-screen summary is posted when a capture is sealed.",
                    "properties": {
                      "route": {
                        "default": "",
                        "description": "The name of a route from the chart's `notify.routes`. Empty (the default) means this profile's captures are not announced anywhere.",
                        "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$|^$",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "postSeconds": {
                    "default": 300,
                    "description": "Seconds of window after the trigger firing time.",
                    "format": "uint32",
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "preSeconds": {
                    "default": 300,
                    "description": "Seconds of window before the trigger firing time (best-effort; see DESIGN §3).",
                    "format": "uint32",
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "redaction": {
                    "default": {
                      "mode": "default"
                    },
                    "description": "Credential redaction applied to captured objects before they are written.",
                    "properties": {
                      "mode": {
                        "default": "default",
                        "description": "\"default\" (name + value rules), \"strict\" (every candidate value except `plaintext` names), or \"off\" (recorded in the bundle and flagged by `lapilli verify`).",
                        "enum": [
                          "default",
                          "strict",
                          "off"
                        ],
                        "type": "string"
                      },
                      "plaintext": {
                        "description": "Env/header/annotation names exempt from `strict`.",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "signing": {
                    "default": {
                      "mode": "none"
                    },
                    "description": "Signing mode. v0.1: \"none\" (default) or \"static\".",
                    "properties": {
                      "keySecret": {
                        "description": "For mode=static: name of a Secret holding a PKCS#8 PEM private key under `key.pem`.",
                        "nullable": true,
                        "type": "string"
                      },
                      "mode": {
                        "default": "none",
                        "description": "\"none\" (default) or \"static\". KMS/keyless are later versions.",
                        "enum": [
                          "none",
                          "static"
                        ],
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "CaptureProfile",
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {}
      }
    ]
  }
}

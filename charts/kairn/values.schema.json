{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Kairn chart values",
  "description": "Unknown keys in Kairn's own sections are rejected so a typo can't be silently ignored. `global` is allowed for umbrella charts. See docs/COMPATIBILITY.md §5.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "clusterId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,83}$"
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "postSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "collectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "logs",
              "resources",
              "events",
              "changes",
              "metrics"
            ]
          }
        },
        "notifyRoute": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
          "description": "The name of a notify.routes entry whose channel this profile's captures are announced in. Empty (default): not announced."
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusUrl": {
          "description": "Empty (off) or an http(s) base URL with a plain host[:port] and an optional path prefix. No credentials, query, fragment or bracketed IP literal (write a name or an IPv4 literal): the controller refuses those, and plain http:// only for cluster-local or loopback hosts.",
          "type": "string",
          "pattern": "^(|https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~-]+)*/?)$"
        },
        "stepSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "query": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "diffs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMaps": {
          "type": "boolean"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "default",
            "strict",
            "off"
          ]
        },
        "plaintext": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "static",
            "kms"
          ]
        },
        "keySecret": {
          "type": "string"
        },
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "pattern": "^arn:(aws|aws-cn|aws-us-gov):kms:[a-z0-9-]+:[0-9]{12}:key/[A-Za-z0-9_-]+$"
                },
                {
                  "pattern": "^projects/[A-Za-z0-9_-]+/locations/[A-Za-z0-9_-]+/keyRings/[A-Za-z0-9_-]+/cryptoKeys/[A-Za-z0-9_-]+/cryptoKeyVersions/[0-9]+$"
                }
              ]
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "logLevel": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "url": {
                "type": "string",
                "pattern": "^(s3|gs)://[^/]+(/.*)?$"
              },
              "region": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "allowHttp": {
                "type": "boolean"
              },
              "credentialsSecret": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrapeAnnotations": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "description": "Notification destinations. A CaptureProfile may only name one of these; it cannot define a route, point it elsewhere, or raise its detail level.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "host",
              "pathSecret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
                "description": "What a CaptureProfile's spec.notify.route references."
              },
              "host": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(:[0-9]{1,5})?$",
                "description": "host[:port], never a URL: no scheme, no path, no credentials. Lives here rather than in the Secret so a change rolls the pod and cannot silently repoint the endpoint."
              },
              "pathSecret": {
                "type": "string",
                "minLength": 1,
                "description": "Secret in the release namespace with a `path` key, e.g. /services/T000/B000/xxxx. Only that key is mounted."
              },
              "format": {
                "enum": [
                  "slack",
                  "json"
                ]
              },
              "detail": {
                "enum": [
                  "facts",
                  "content"
                ],
                "description": "facts: no value taken from the workload. content: also the changed field and its redacted before/after values. A log line is never sent in either mode."
              },
              "maxPerWindow": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "includeDemo": {
                "type": "boolean",
                "description": "Also announce captures labelled kairn.dev/export: local, which is what `kairn demo` creates."
              },
              "insecureHttp": {
                "type": "boolean",
                "description": "Talk to this route over plain HTTP. Tests only: it also needs KAIRN_NOTIFY_ALLOW_HTTP in extraEnv, and even then only a cluster-local or loopback host is accepted."
              }
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 25,
      "description": "Seconds the kubelet waits after SIGTERM before SIGKILL. Kairn needs at least 25: the captures in flight get 12s and the notification flush 10s, and a truncated flush marks captures notified that were never announced."
    }
  }
}

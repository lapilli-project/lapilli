{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Kairn chart values",
  "description": "Unknown keys in Kairn's own sections are rejected so a typo can't be silently ignored. `global` is allowed for umbrella charts. See docs/COMPATIBILITY.md \u00a75.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "clusterId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,83}$"
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "postSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "collectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "logs",
              "resources",
              "events",
              "changes",
              "metrics"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusUrl": {
          "type": "string"
        },
        "stepSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "query": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "diffs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMaps": {
          "type": "boolean"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "default",
            "strict",
            "off"
          ]
        },
        "plaintext": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "static",
            "kms"
          ]
        },
        "keySecret": {
          "type": "string"
        },
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "pattern": "^arn:(aws|aws-cn|aws-us-gov):kms:[a-z0-9-]+:[0-9]{12}:key/[A-Za-z0-9_-]+$"
                },
                {
                  "pattern": "^projects/[A-Za-z0-9_-]+/locations/[A-Za-z0-9_-]+/keyRings/[A-Za-z0-9_-]+/cryptoKeys/[A-Za-z0-9_-]+/cryptoKeyVersions/[0-9]+$"
                }
              ]
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "logLevel": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "url": {
                "type": "string",
                "pattern": "^(s3|gs)://[^/]+(/.*)?$"
              },
              "region": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "allowHttp": {
                "type": "boolean"
              },
              "credentialsSecret": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrapeAnnotations": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}

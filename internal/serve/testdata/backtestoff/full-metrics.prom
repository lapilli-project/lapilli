lapilli_serve_source_firings{source="test-src"} 4
# HELP lapilli_serve_source_quiet_seconds How long a source may go without firings copied in before it is told of (--source-quiet).
# TYPE lapilli_serve_source_quiet_seconds gauge
lapilli_serve_source_quiet_seconds 93600
# HELP lapilli_rule_replay_check The replay beside what really fired over the seven whole days before today, by rule: firings alike, only in the replay, and only in what really fired. Rules that share an alert name, which what really fired doesn't tell apart, each carry the counts of them all.
# TYPE lapilli_rule_replay_check gauge
lapilli_rule_replay_check{rule="Errors",way="alike"} 16
lapilli_rule_replay_check{rule="Errors",way="replayed"} 5
lapilli_rule_replay_check{rule="Errors",way="real"} 1
lapilli_rule_replay_check{rule="Limited",way="alike"} 0
lapilli_rule_replay_check{rule="Limited",way="replayed"} 21
lapilli_rule_replay_check{rule="Limited",way="real"} 0
# HELP lapilli_serve_replay_checked_to_timestamp_seconds How far the replay has been set beside what really fired, in Unix seconds.
# TYPE lapilli_serve_replay_checked_to_timestamp_seconds gauge
lapilli_serve_replay_checked_to_timestamp_seconds 1793664000
# HELP lapilli_rule_content_problems Problems with what each rule says when it fires, or how it is written, by check: facts and what was measured, not guesses (docs/design/content.md).
# TYPE lapilli_rule_content_problems gauge
lapilli_rule_content_problems{rule="Errors",check="no_text"} 1
lapilli_rule_content_problems{rule="Errors",check="no_runbook"} 1
lapilli_rule_content_problems{rule="Limited",check="no_text"} 1
lapilli_rule_content_problems{rule="Limited",check="no_runbook"} 1
lapilli_rule_content_problems{rule="Limited",check="no_severity"} 1
# HELP lapilli_serve_history_requests_total Requests lapilli serve sent to each history API since it started, by the kind of API and the class of the answer: 2xx, 3xx, 4xx, 5xx, or none (refused, dropped, timed out).
# TYPE lapilli_serve_history_requests_total counter
lapilli_serve_history_requests_total{api="prometheus",answer="2xx"} 0
lapilli_serve_history_requests_total{api="prometheus",answer="3xx"} 0
lapilli_serve_history_requests_total{api="prometheus",answer="4xx"} 0
lapilli_serve_history_requests_total{api="prometheus",answer="5xx"} 0
lapilli_serve_history_requests_total{api="prometheus",answer="none"} 0
# HELP lapilli_serve_history_throttled_total Answers of HTTP 429, too many requests, from each history API since lapilli serve started.
# TYPE lapilli_serve_history_throttled_total counter
lapilli_serve_history_throttled_total{api="prometheus"} 0
# HELP lapilli_serve_history_retries_total Requests to each history API asked again after an answer that said to (HTTP 429, 5xx) or a connection dropped, since lapilli serve started.
# TYPE lapilli_serve_history_retries_total counter
lapilli_serve_history_retries_total{api="prometheus"} 0
# HELP lapilli_serve_history_wait_seconds_total Seconds requests to each history API waited before they were sent, summed over the requests, since lapilli serve started: for the API (reason api: a wait it asked for, Retry-After, and before asking again) and for a turn by a rate (reason rate: --max-rate, --catch-up-rate).
# TYPE lapilli_serve_history_wait_seconds_total counter
lapilli_serve_history_wait_seconds_total{api="prometheus",reason="api"} <clock>
lapilli_serve_history_wait_seconds_total{api="prometheus",reason="rate"} <clock>
# HELP lapilli_serve_history_yields_total Times the runs yielded to each history API, as it answered HTTP 429 (--yield-on-429), since lapilli serve started.
# TYPE lapilli_serve_history_yields_total counter
lapilli_serve_history_yields_total{api="prometheus"} 0

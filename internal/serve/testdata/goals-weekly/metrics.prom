# HELP lapilli_goal_known Whether each goal's last whole week is known, met or missed, for everyone (no team label) and each team it is of: 1 or 0. Not known is a week with no record for a goal that needs one, a share with nothing to divide, or a week the ledger doesn't hold whole (docs/design/goals.md).
# TYPE lapilli_goal_known gauge
lapilli_goal_known{goal="no-refire",team="search"} 1
lapilli_goal_known{goal="none-missed"} 1
lapilli_goal_known{goal="every-missed",team="search"} 0
lapilli_goal_known{goal="critical-caught"} 1
lapilli_goal_known{goal="every-missed",team="payments"} 1
lapilli_goal_known{goal="no-refire",team="payments"} 1
lapilli_goal_known{goal="paged",team="payments"} 1
# HELP lapilli_goal_met Whether each goal was met in the last whole week: 1, or 0 when missed; no series when not known (lapilli_goal_known).
# TYPE lapilli_goal_met gauge
lapilli_goal_met{goal="no-refire",team="search"} 0
lapilli_goal_met{goal="none-missed"} 0
lapilli_goal_met{goal="critical-caught"} 1
lapilli_goal_met{goal="every-missed",team="payments"} 1
lapilli_goal_met{goal="no-refire",team="payments"} 1
lapilli_goal_met{goal="paged",team="payments"} 1
# HELP lapilli_goal_value Each goal's measure over the last whole week, when it is known: a share from 0 to 1, a count, or seconds.
# TYPE lapilli_goal_value gauge
lapilli_goal_value{goal="no-refire",team="search"} 1
lapilli_goal_value{goal="none-missed"} 1
lapilli_goal_value{goal="critical-caught"} 1
lapilli_goal_value{goal="every-missed",team="payments"} 0
lapilli_goal_value{goal="no-refire",team="payments"} 0
lapilli_goal_value{goal="paged",team="payments"} 2
# HELP lapilli_goal_weeks_met Whole weeks, of the twelve before this one, in which each goal was met: beside lapilli_weeks_counted.
# TYPE lapilli_goal_weeks_met gauge
lapilli_goal_weeks_met{goal="no-refire",team="search"} 2
lapilli_goal_weeks_met{goal="none-missed"} 1
lapilli_goal_weeks_met{goal="every-missed",team="search"} 0
lapilli_goal_weeks_met{goal="critical-caught"} 1
lapilli_goal_weeks_met{goal="every-missed",team="payments"} 2
lapilli_goal_weeks_met{goal="no-refire",team="payments"} 3
lapilli_goal_weeks_met{goal="paged",team="payments"} 3